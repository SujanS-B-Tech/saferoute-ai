APP_ENV=development
DATABASE_URL=sqlite:///./saferoute.db
# Production: postgresql+psycopg://saferoute:change-me@db:5432/saferoute
JWT_SECRET=generate-a-long-random-string   # required when APP_ENV=production
JWT_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173
DEMO_MODE=true
ROUTING_PROVIDER=demo        # demo | osrm
OSRM_BASE_URL=               # your own OSRM instance; do not bulk-use public servers
